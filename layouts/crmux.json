{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "header",
      "type": "block",
      "size": { "px": 28 },
      "background": "chrome",
      "window_drag": true,
      "content": { "mod": "crmux-tabs" }
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "list",
          "type": "block",
          "size": { "px": 280 },
          "background": "chrome",
          "window_drag": true,
          "content": { "mod": "crmux-list" }
        },
        {
          "id": "preview",
          "type": "block",
          "border": { "width": 1, "color": "border" },
          "focus": { "border": { "width": 1, "color": "accent" } },
          "content": { "agent": "focused" }
        }
      ]
    },
    {
      "id": "footer",
      "type": "block",
      "size": { "px": 28 },
      "background": "chrome",
      "content": { "mod": "crmux-footer" }
    }
  ]
}

{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "header",
      "type": "block",
      "size": { "px": 34 },
      "background": "chrome",
      "window_drag": true,
      "content": { "mod": "crmux-tabs" }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 6,
      "padding": 6,
      "children": [
        {
          "id": "list",
          "type": "block",
          "size": { "px": 280 },
          "background": "chrome",
          "window_drag": true,
          "content": { "mod": "crmux-list" }
        },
        {
          "id": "preview",
          "type": "column",
          "border": { "width": 1, "color": "border" },
          "radius": 6,
          "background": "background",
          "children": [
            {
              "id": "preview-title",
              "type": "block",
              "size": { "px": 30 },
              "content": { "mod": "crmux-title" }
            },
            {
              "id": "preview-body",
              "type": "block",
              "radius": 5,
              "content": { "agent": "focused" }
            }
          ]
        }
      ]
    },
    {
      "id": "footer",
      "type": "block",
      "size": { "px": 28 },
      "background": "chrome",
      "content": { "mod": "crmux-footer" }
    }
  ]
}
